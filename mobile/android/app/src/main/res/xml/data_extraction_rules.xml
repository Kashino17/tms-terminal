<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ cloud backup and device-to-device transfer: same rule. -->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="sharedpref" path="tms_bubble.xml"/>
  </cloud-backup>
  <device-transfer>
    <exclude domain="sharedpref" path="tms_bubble.xml"/>
  </device-transfer>
</data-extraction-rules>
